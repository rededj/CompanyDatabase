<Window x:Class="BDcource.Features.Blueprints.BlueprintEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чертеж" Height="300" Width="500" WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize" Background="{StaticResource BackgroundColor}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="27"/>
            <RowDefinition Height="Auto" MinHeight="109"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="149"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Номер чертежа:" 
                   FontFamily="Tahoma" FontSize="12" VerticalAlignment="Center" Height="14"/>
        <TextBox Grid.Row="0" Grid.Column="1" Name="txtBlueprintNumber" Margin="0,5,0,5" FontFamily="Tahoma" FontSize="12"/>

        <TextBlock Text="Технические требования:" 
                   FontFamily="Tahoma" FontSize="12" TextWrapping="Wrap" Margin="0,26,0,0" HorizontalAlignment="Center" Grid.RowSpan="2" Width="151"/>
        <TextBox Grid.Column="1" Name="txtTechnicalRequirements" TextWrapping="Wrap" 
                 AcceptsReturn="True" MinHeight="100" Margin="0,26,0,10" FontFamily="Tahoma" FontSize="12" Grid.RowSpan="2"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="1,5,0,5" Grid.Column="1" Width="180">
            <Button Name="btnOk" Content="OK" Style="{StaticResource ClassicButton}" Width="80" Margin="5" Click="BtnOk_Click"/>
            <Button Name="btnCancel" Content="Отмена" Style="{StaticResource ClassicButton}" Width="80" Margin="5" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>