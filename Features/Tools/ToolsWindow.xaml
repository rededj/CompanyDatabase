<Window x:Class="BDcource.Features.Tools.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Инструменты" Height="400" Width="700" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Список инструментов" Style="{StaticResource TitleTextBlock}"/>

        <DataGrid Grid.Row="1" Name="dgTools" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" SelectionMode="Single" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Серийный номер" Binding="{Binding SerialNumber}" Width="*"/>
                <DataGridTextColumn Header="Тип инструмента" Binding="{Binding ToolType.Name}" Width="*"/>
                <DataGridTextColumn Header="Дата поступления" Binding="{Binding ArrivalDate, StringFormat=dd.MM.yyyy}" Width="*"/>
                <DataGridTextColumn Header="Выдан в наряд" Binding="{Binding CurrentWorkOrder.Product.Name}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="btnAdd" Content="Добавить" Style="{StaticResource ClassicButton}" Width="80" Margin="5" Click="BtnAdd_Click"/>
            <Button Name="btnEdit" Content="Редактировать" Style="{StaticResource ClassicButton}" Width="120" Margin="5" Click="BtnEdit_Click"/>
            <Button Name="btnDelete" Content="Удалить" Style="{StaticResource ClassicButton}" Width="80" Margin="5" Click="BtnDelete_Click"/>
            <Button Name="btnClose" Content="Закрыть" Style="{StaticResource ClassicButton}" Width="80" Margin="5" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>