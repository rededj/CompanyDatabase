<Window x:Class="BDcource.Features.Operations.OperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Операции" Height="450" Width="700" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Список операций" Style="{StaticResource TitleTextBlock}"/>

        <DataGrid Grid.Row="1" Name="dgOperations" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" SelectionMode="Single" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Ср. длительность" Binding="{Binding AverageDuration, StringFormat='HH\\:mm'}" Width="*"/>
                <DataGridTextColumn Header="Цех" Binding="{Binding Workshop.WorkshopName}" Width="*"/>
                <DataGridTextColumn Header="Чертёж" Binding="{Binding BlueprintNumberNavigation.BlueprintNumber}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="btnView" Content="Просмотр" Style="{StaticResource ClassicButton}" Width="80" Margin="5" Click="BtnView_Click" Visibility="Collapsed"/>
            <Button Name="btnAdd" Content="Добавить" Style="{StaticResource ClassicButton}" Width="80" Margin="5" Click="BtnAdd_Click"/>
            <Button Name="btnEdit" Content="Редактировать" Style="{StaticResource ClassicButton}" Width="105" Margin="5" Click="BtnEdit_Click"/>
            <Button Name="btnDelete" Content="Удалить" Style="{StaticResource ClassicButton}" Width="80" Margin="5" Click="BtnDelete_Click"/>
            <Button Name="btnClose" Content="Закрыть" Style="{StaticResource ClassicButton}" Width="80" Margin="5" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>