<Window x:Class="BDcource.Features.WorkOrders.WorkOrderEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Наряд" Height="320" Width="480" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource BackgroundColor}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Name="Header" Grid.Row="0" Grid.ColumnSpan="2" 
                   Style="{StaticResource TitleTextBlock}" Margin="0,0,0,15"><Run Language="ru-ru" Text="Добавление"/><Run Text=" наряда"/></TextBlock>

        <Label Grid.Row="1" Grid.Column="0" Content="Продукт:" FontFamily="Tahoma" FontSize="12" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Name="cbProduct" DisplayMemberPath="Name" SelectedValuePath="ProductId" 
                  Margin="0,5,0,5" FontFamily="Tahoma" FontSize="12"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Дата регистрации:" FontFamily="Tahoma" FontSize="12" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="2" Grid.Column="1" Name="dpRegistrationDate" 
                    SelectedDateFormat="Short" Margin="0,5,0,5" FontFamily="Tahoma" FontSize="12"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Срок выполнения:" FontFamily="Tahoma" FontSize="12" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="3" Grid.Column="1" Name="dpDueDate" 
                    SelectedDateFormat="Short" Margin="0,5,0,5" FontFamily="Tahoma" FontSize="12"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Количество:" FontFamily="Tahoma" FontSize="12" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" Name="txtRequiredQuantity" Margin="0,5,0,5" FontFamily="Tahoma" FontSize="12"/>

        <Label Grid.Row="5" Grid.Column="0" Content="Выполнен:" FontFamily="Tahoma" FontSize="12" VerticalAlignment="Center"/>
        <CheckBox Grid.Row="5" Grid.Column="1" Name="chkCompleted" Margin="5,0,-5,0" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Name="btnOk" Content="OK" Style="{StaticResource ClassicButton}" Width="80" Margin="5" Click="BtnOk_Click"/>
            <Button Name="btnCancel" Content="Отмена" Style="{StaticResource ClassicButton}" Width="80" Margin="5" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>