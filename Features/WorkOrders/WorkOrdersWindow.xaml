<Window x:Class="BDcource.Features.WorkOrders.WorkOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Наряды" Height="450" Width="750" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Список нарядов" Style="{StaticResource TitleTextBlock}"/>

        <DataGrid Grid.Row="1" Name="dgWorkOrders" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" SelectionMode="Single" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Продукт" Binding="{Binding Product.Name}" Width="*"/>
                <DataGridTextColumn Header="Дата регистрации" Binding="{Binding RegistrationDate, StringFormat=dd.MM.yyyy}" Width="*"/>
                <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat=dd.MM.yyyy}" Width="*"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding RequiredQuantity}" Width="*"/>
                <DataGridCheckBoxColumn Header="Выполнен" Binding="{Binding Completed}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="btnAdd" Content="Добавить" Style="{StaticResource ClassicButton}" Width="80" Margin="5" Click="BtnAdd_Click"/>
            <Button Name="btnEdit" Content="Редактировать" Style="{StaticResource ClassicButton}" Width="120" Margin="5" Click="BtnEdit_Click"/>
            <Button Name="btnDelete" Content="Удалить" Style="{StaticResource ClassicButton}" Width="80" Margin="5" Click="BtnDelete_Click"/>
            <Button Name="btnClose" Content="Закрыть" Style="{StaticResource ClassicButton}" Width="80" Margin="5" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>