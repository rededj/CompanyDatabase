<Window x:Class="BDcource.Features.Reports.Query4Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Наряды за период с инструментами" Height="450" Width="950" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Наряды за период с инструментами" 
                   Style="{StaticResource TitleTextBlock}" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Дата начала:" VerticalAlignment="Center" Margin="0,0,5,0" FontFamily="Tahoma" FontSize="12"/>
            <DatePicker Name="dpStart" SelectedDateFormat="Short" Width="120" Margin="0,0,10,0" FontFamily="Tahoma" FontSize="12" Height="24"/>
            <TextBlock Text="Дата окончания:" VerticalAlignment="Center" Margin="0,0,5,0" FontFamily="Tahoma" FontSize="12"/>
            <DatePicker Name="dpEnd" SelectedDateFormat="Short" Width="120" Margin="0,0,10,0" FontFamily="Tahoma" FontSize="12" Height="23"/>
            <Button Content="Показать" Style="{StaticResource ClassicButton}" Width="80" Click="ShowReport_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="2" Name="dgResult" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" SelectionMode="Single" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Продукт" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Дата регистрации" Binding="{Binding RegistrationDate, StringFormat=dd.MM.yyyy}" Width="*"/>
                <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat=dd.MM.yyyy}" Width="*"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding RequiredQuantity}" Width="*"/>
                <DataGridCheckBoxColumn Header="Выполнен" Binding="{Binding Completed}" Width="*"/>
                <DataGridTextColumn Header="Инструмент" Binding="{Binding ToolSerialNumber}" Width="*"/>
                <DataGridTextColumn Header="Тип инструмента" Binding="{Binding ToolTypeName}" Width="*"/>
                <DataGridTextColumn Header="Дата выдачи" Binding="{Binding IssueDate, StringFormat=dd.MM.yyyy}" Width="*"/>
                <DataGridTextColumn Header="Дата возврата" Binding="{Binding ReturnDate, StringFormat=dd.MM.yyyy}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="3" Content="Закрыть" Style="{StaticResource ClassicButton}" Width="80" 
                HorizontalAlignment="Right" Margin="0,15,0,0" Click="Close_Click"/>
    </Grid>
</Window>