<Window x:Class="BDcource.Features.Reports.Query7Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товары с используемыми инструментами" Height="400" Width="700" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Список товаров и используемых при их изготовлении инструментов" 
                   Style="{StaticResource TitleTextBlock}" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1" Name="dgResult" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" SelectionMode="Single" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Тип инструмента" Binding="{Binding ToolTypeName}" Width="*"/>
                <DataGridTextColumn Header="Количество в использовании" Binding="{Binding QuantityInUse}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Закрыть" Style="{StaticResource ClassicButton}" Width="80" 
                HorizontalAlignment="Right" Margin="0,15,0,0" Click="Close_Click"/>
    </Grid>
</Window>