<Window x:Class="BDcource.Features.Reports.Query6Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Расходные материалы по использованию" Height="400" Width="600" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Материалы, отсортированные по количеству использования" 
                   Style="{StaticResource TitleTextBlock}" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1" Name="dgResult" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" SelectionMode="Single" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="*"/>
                <DataGridTextColumn Header="Общее количество" Binding="{Binding TotalQuantity}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Закрыть" Style="{StaticResource ClassicButton}" Width="80" 
                HorizontalAlignment="Right" Margin="0,15,0,0" Click="Close_Click"/>
    </Grid>
</Window>