<Window x:Class="BDcource.Features.ProductsOperations.ProductOperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Операции продукта" Height="450" Width="650" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Операции для продукта" Style="{StaticResource TitleTextBlock}" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="1" Name="txtProductName" FontFamily="Tahoma" FontSize="12" 
                   Foreground="{StaticResource PrimaryColor}" FontWeight="SemiBold" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="2" Name="dgOperations" IsReadOnly="True"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" SelectionMode="Single" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Цех" Binding="{Binding Workshop.Adress}" Width="*"/>
                <DataGridTextColumn Header="Длительность" Binding="{Binding AverageDuration, StringFormat='HH\\:mm'}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="btnAdd" Content="Добавить операцию" Style="{StaticResource ClassicButton}" Width="150" Margin="5" Click="BtnAdd_Click"/>
            <Button Name="btnRemove" Content="Удалить" Style="{StaticResource ClassicButton}" Width="75" Margin="5" Click="BtnRemove_Click"/>
            <Button Name="btnClose" Content="Закрыть" Style="{StaticResource ClassicButton}" Width="80" Margin="5" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>