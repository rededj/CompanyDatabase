<Window x:Class="BDcource.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь" Height="380" Width="450" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource BackgroundColor}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Name ="Header" Grid.Row="0" Grid.ColumnSpan="2" 
                   Style="{StaticResource TitleTextBlock}" Margin="-1,0,1,15"><Run Language="ru-ru" Text="Добавление "/><Run Text="пользователя"/></TextBlock>

        <Label Grid.Row="1" Grid.Column="0" Content="Логин:" FontFamily="Tahoma" FontSize="12" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Name="txtLogin" Margin="0,5,0,5" FontFamily="Tahoma" FontSize="12"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Пароль:" FontFamily="Tahoma" FontSize="12" VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="2" Grid.Column="1" Name="txtPassword" Margin="0,5,0,5" FontFamily="Tahoma" FontSize="12"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Роль:" FontFamily="Tahoma" FontSize="12" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Name="cbRole" DisplayMemberPath="RoleName" SelectedValuePath="RoleId" 
                  Margin="0,5,0,5" FontFamily="Tahoma" FontSize="12"/>

        <Label Grid.Row="4" Grid.Column="0" Content="ФИО:" FontFamily="Tahoma" FontSize="12" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" Name="txtName" Margin="0,5,0,5" FontFamily="Tahoma" FontSize="12"/>

        <Label Grid.Row="5" Grid.Column="0" Content="Должность:" FontFamily="Tahoma" FontSize="12" VerticalAlignment="Center"/>
        <TextBox Grid.Row="5" Grid.Column="1" Name="txtPosition" Margin="0,5,0,5" FontFamily="Tahoma" FontSize="12"/>

        <Label Grid.Row="6" Grid.Column="0" Content="Цех:" FontFamily="Tahoma" FontSize="12" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="6" Grid.Column="1" Name="cbWorkshop" 
          Margin="0,5,0,5" FontFamily="Tahoma" FontSize="12" IsEditable="False"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Name="btnOk" Content="OK" Style="{StaticResource ClassicButton}" Width="80" Margin="5" Click="BtnOk_Click"/>
            <Button Name="btnCancel" Content="Отмена" Style="{StaticResource ClassicButton}" Width="80" Margin="5" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>